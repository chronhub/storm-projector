{
    "name": "chronhub/storm-projector",
    "description": "Storm Projector — read-model / projection engine + console.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "projection", "read-model"],
    "require": {
        "php": ">=8.5",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-chronicler": "self.version",
        "chronhub/storm-event-links": "self.version",
        "chronhub/storm-stream": "self.version",
        "chronhub/storm-support": "self.version",
        "doctrine/dbal": "^4.0",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/string": "^8.1"
    },
    "require-dev": {
        "chronhub/storm-clock": "self.version",
        "chronhub/storm-message": "self.version",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Projector\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Projector\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
